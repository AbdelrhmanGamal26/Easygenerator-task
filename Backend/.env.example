NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://admin:change-me-root-password@localhost:27017/easygenerator?authSource=admin
# Min 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:5173
# Reverse-proxy hops in front of the app (0 = none); needed for per-user rate limits behind a proxy
TRUST_PROXY=0
# lax | strict | none (none = cross-site frontend, forces Secure cookies)
COOKIE_SAME_SITE=lax
LOG_LEVEL=info

# MongoDB container (docker compose). Use URL-safe passwords, or percent-encode them in MONGODB_URI.
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=change-me-root-password
